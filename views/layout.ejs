<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - AIORI Surface Monitor</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, sans-serif; color: #17212b; background: #f3f6f8; }
    body { margin: 0; }
    header { background: #102a43; color: #fff; padding: 1rem max(1rem, calc((100% - 1100px) / 2)); }
    header h1 { margin: 0 0 .75rem; font-size: 1.25rem; }
    nav { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
    nav a, nav button { color: #fff; font: inherit; }
    nav a { text-decoration: none; padding: .35rem .55rem; border-radius: 4px; }
    nav a.active { background: #335c81; }
    nav form { margin-left: auto; }
    main { max-width: 1100px; margin: 1.5rem auto; padding: 0 1rem 2rem; }
    section, .card { background: #fff; border: 1px solid #d6dee5; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
    form.stack { display: grid; gap: .7rem; max-width: 600px; }
    label { display: grid; gap: .25rem; }
    input { padding: .55rem; border: 1px solid #9aabb9; border-radius: 4px; }
    input[type=checkbox] { width: auto; }
    button { border: 0; border-radius: 4px; padding: .55rem .8rem; color: #fff; background: #176b87; cursor: pointer; }
    button:hover { background: #0e536c; }
    .inline-form { display: inline-flex; gap: .45rem; align-items: center; margin: .25rem .4rem .25rem 0; }
    .inline-form label { display: flex; gap: .35rem; align-items: center; }
    .notice { padding: .75rem; border-left: 4px solid #176b87; background: #e5f4f8; }
    .error { border-color: #a12622; background: #fff0ef; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { text-align: left; vertical-align: top; padding: .65rem; border-bottom: 1px solid #d6dee5; overflow-wrap: anywhere; }
    th { background: #edf2f6; }
    .muted { color: #526575; }
    .nowrap { white-space: nowrap; }
    @media (max-width: 700px) { table { display: block; overflow-x: auto; } nav form { margin-left: 0; } }
  </style>
</head>
<body>
  <header>
    <h1>AIORI Authorized Surface Monitor</h1>
    <nav aria-label="Main navigation">
      <a class="<%= activePage === 'inventory' ? 'active' : '' %>" href="/dashboard">Inventory</a>
      <a class="<%= activePage === 'changes' ? 'active' : '' %>" href="/dashboard/changes">Changes</a>
      <a class="<%= activePage === 'audit' ? 'active' : '' %>" href="/dashboard/audit">Audit</a>
      <span>Signed in as <%= username %></span>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Log out</button>
      </form>
    </nav>
  </header>
  <main>
    <% if (message) { %><p class="notice"><%= message %></p><% } %>
    <!--PAGE_CONTENT-->
  </main>
</body>
</html>
