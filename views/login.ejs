<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in - Attack Surface Monitor</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="login-page">
  <main class="login-card">
    <div class="brand-mark" aria-hidden="true">ASM</div>
    <h1>Attack Surface Monitor</h1>
    <p class="subtitle">Authorized discovery and change monitoring</p>
    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>
    <form class="stack" method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="username">Username
        <input id="username" name="username" autocomplete="username" required>
      </label>
      <label for="password">Password
        <input id="password" type="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="button button-primary button-wide" type="submit">Sign in</button>
    </form>
    <p class="login-note">Access is limited to the configured administrator account.</p>
  </main>
</body>
</html>
