<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Authorized discovery and change monitoring dashboard">
  <title><%= title %> - Attack Surface Monitor</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/dashboard">Attack Surface Monitor</a>
    <nav class="main-nav" aria-label="Main navigation">
      <a class="<%= activePage === 'overview' ? 'active' : '' %>" href="/dashboard">Overview</a>
      <a class="<%= activePage === 'inventory' ? 'active' : '' %>" href="/dashboard/inventory">Inventory</a>
      <a class="<%= activePage === 'changes' ? 'active' : '' %>" href="/dashboard/changes">Changes</a>
      <a class="<%= activePage === 'audit' ? 'active' : '' %>" href="/dashboard/audit">Audit</a>
      <a class="<%= activePage === 'how-it-works' ? 'active' : '' %>" href="/dashboard/how-it-works">How it works</a>
      <span class="nav-user">Signed in: <%= username %></span>
      <form method="post" action="/logout" class="logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button button-nav" type="submit">Logout</button>
      </form>
    </nav>
  </header>
  <main class="page-shell">
    <% if (message) { %>
      <div class="alert alert-<%= alertType %>" role="status"><%= message %></div>
    <% } %>
    <!--PAGE_CONTENT-->
  </main>
  <footer class="site-footer">Authorized discovery only · Out-of-scope targets are blocked.</footer>
</body>
</html>
